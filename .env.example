# 本地验证使用 8443；生产环境通常改为 443。
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTPS_PORT=8443

# 服务端证书使用的 IPv4，必须与客户端实际访问地址完全匹配。
# 这里是本地示例；生产请通过 cloudctl.sh init 写入云服务器公网 IP。
SERVER_NAME=127.0.0.1

# 内部服务器访问公网时呈现的固定出口 IP/CIDR。生产环境不得保留 0.0.0.0/0。
ALLOWED_CLIENT_CIDR=0.0.0.0/0

# Worker 服务端硬限制。
DEFAULT_TIMEOUT_MS=30000
MAX_TIMEOUT_MS=60000
CONNECT_TIMEOUT_MS=5000
RESPONSE_HEADER_TIMEOUT_MS=15000
DEFAULT_MAX_BYTES=10485760
HARD_MAX_BYTES=52428800
DEFAULT_MAX_REDIRECTS=5
HARD_MAX_REDIRECTS=10
MAX_CONCURRENCY=100

# 生产环境必须加入云服务器自身公网 IP，例如 203.0.113.20/32；多个网段用逗号分隔。
BLOCKED_CIDRS=127.0.0.1/32

# MCP 透明代理（streamable-http），默认启用：上游由 x-mcp-host 头指定，
# 任意公网 http/https 源站均可直达（私网/环回/元数据地址仍被 SSRF 防护拦截）。
PROXY_MAX_CONCURRENCY=50
PROXY_MAX_STREAM_BYTES=104857600
# 配置后 Worker 会把上游 3xx 的 Location 改写为带该前缀的路径，例如 /ia-access-gateway/mcp
PUBLIC_PATH_PREFIX=

# 容器资源上限。
WORKER_MEMORY_LIMIT=512m
WORKER_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=256m
NGINX_CPU_LIMIT=0.5
